  //start of marathi
  mr: {
    // Navigation

    // Hero Section
    hero_description:
      "आमच्या व्यापक डिजिटल प्लॅटफॉर्मसह तुमच्या शेती ऑपरेशन्सचे रूपांतर करा। हजारो शेतकऱ्यांना सामील व्हा ज्यांनी आमच्या नाविन्यपूर्ण उपायांचा वापर करून त्यांची उत्पादकता 40% वाढवली आहे.",

    // Services
    services_description:
      "तुमच्या आंतरराष्ट्रीय व्यापार ऑपरेशन्स सुव्यवस्थित करण्यासाठी आणि अनुपालन सुनिश्चित करण्यासाठी आवश्यक असलेली प्रत्येक गोष्ट",

    // Features
    features_description:
      "शेतकऱ्यांना कोणत्या अनन्य आव्हानांना सामोरे जावे लागते हे आम्हाला समजते. म्हणूनच आम्ही एक प्लॅटफॉर्म तयार केले आहे जे अत्याधुनिक तंत्रज्ञानाला खोल कृषी तज्ञतेसह जोडते.",

    // Dashboard

    // Dashboard specific
    get_started_description:
      "निर्यात-तयार व्यवसाय बनण्याचा तुमचा प्रवास सुरू करा। आंतरराष्ट्रीय व्यापार सुरू करण्यासाठी तुमची प्रोफाइल आणि आवश्यक दस्तऐवजीकरण पूर्ण करा।",

    // Registration page specific
    required_registrations_description:
      "निर्यात-तयार बनण्यासाठी खाली दिलेल्या सर्व 5 नोंदणी पूर्ण करा. तुमच्या व्यावसायिक गरजांनुसार कोणत्याही नोंदणीपासून सुरुवात करा.",

    // Services/Import Export
