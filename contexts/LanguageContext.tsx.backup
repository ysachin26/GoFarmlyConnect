  //start of hindi
  hi: {
    // Navigation

    // Hero Section
    hero_description:
      "अपने कृषि संचालन को हमारे व्यापक डिजिटल प्लेटफॉर्म के साथ बदलें। हजारों किसानों से जुड़ें जिन्होंने हमारे नवाचार समाधानों का उपयोग करके अपनी उत्पादकता 40% बढ़ाई है।",

    // Services
    join_thousands: "हजारों आयातकों और निर्यातकों से जुड़ें जिन्होंने गोफार्मलीकनेक्ट के साथ अपने संचालन को डिजिटल बनाया है",

    // Features
    features_description:
      "हम समझते हैं कि किसानों को किन अनूठी चुनौतियों का सामना करना पड़ता है। इसीलिए हमने एक प्लेटफॉर्म बनाया है जो अत्याधुनिक तकनीक को गहरी कृषि विशेषज्ञता के साथ जोड़ता है।",

    // Dashboard

    // Dashboard specific
    get_started_description:
      "निर्यात-तैयार व्यवसाय बनने की अपनी यात्रा शुरू करें। अंतर्राष्ट्रीय व्यापार शुरू करने के लिए अपनी प्रोफाइल और आवश्यक दस्तावेज़ीकरण पूरा करें।",

    // Registration page specific
    required_registrations_description:
      "निर्यात-तैयार बनने के लिए नीचे दिए गए सभी 5 पंजीकरण पूरे करें। अपनी व्यावसायिक आवश्यकताओं के अनुसार किसी भी पंजीकरण से शुरुआत करें।",

    // GST Registration specific - Hindi
    document_requirements_customized_by_business_type: "दस्तावेज़ आवश्यकताएं आपके व्यवसाय प्रकार के अनुसार अनुकूलित की जाएंगी",
    choose_documents_based_on_premise_situation: "अपनी व्यावसायिक परिसर स्थिति के आधार पर अपलोड करने वाले दस्तावेज़ चुनें",
    upload_cancelled_cheque_bank_statement_verification: "बैंक खाता सत्यापन के लिए रद्द किया गया चेक या बैंक स्टेटमेंट अपलोड करें",
    gst_mandatory_turnover_threshold:
      "वार्षिक टर्नओवर ₹40 लाख से अधिक (विशेष श्रेणी राज्यों के लिए ₹10 लाख) वाले व्यवसायों के लिए GST पंजीकरण अनिवार्य है।",
    gst_application_submitted_processing:
      "आपका GST पंजीकरण आवेदन सफलतापूर्वक जमा किया गया है और अब इसकी प्रक्रिया की जा रही है।",

    // Services/Import Export
    hero_content_description:
      "आयात-निर्यात दस्तावेज़ीकरण, सीमा शुल्क निकासी और व्यापार अनुपालन के लिए एक संपूर्ण डिजिटल प्लेटफ़ॉर्म। हमारे स्वचालित फ़ाइलिंग सिस्टम से अपने शिपमेंट को 70% तेज़ी से प्रोसेस करें।",

    // Partners & Integrations
    partners_description:
      "एक व्यापक कृषि पारिस्थितिकी तंत्र बनाने के लिए प्रमुख सरकारी निकायों, वित्तीय संस्थानों और प्रौद्योगिकी भागीदारों के साथ काम करना",

    // Testimonials
    testimonials_description: "हजारों संतुष्ट किसानों से जुड़ें जिन्होंने गोफार्मलीकनेक्ट के साथ अपने कृषि संचालन को बदल दिया है",

    // Learn with us
    learn_description:
      "हमारे व्यापक वीडियो ट्यूटोरियल और विशेषज्ञ मार्गदर्शन के साथ आधुनिक कृषि तकनीकों और डिजिटल कृषि समाधानों में महारत हासिल करें",

    // Tutorial titles

    // Export Registration Tutorial - Hindi

    // Tutorial categories

    // FAQ
    faq_description: "गोफार्मलीकनेक्ट की सुविधाओं, मूल्य निर्धारण और शुरुआत करने के तरीके के बारे में सामान्य प्रश्नों के उत्तर खोजें",

    // Contact Us
    contact_description: "अपने कृषि संचालन को बदलने के लिए तैयार? व्यक्तिगत मार्गदर्शन के लिए हमारे कृषि विशेषज्ञों से संपर्क करें",

    // Footer
    empowering_farmers:
      "आधुनिक कृषि के लिए अत्याधुनिक डिजिटल समाधानों के साथ किसानों को सशक्त बनाना। आज ही कृषि क्रांति में शामिल हों।",

    // Business Details - Hindi
    व्यवसाय_की_प्रकृति: "व्यवसाय की प्रकृति दर्ज करे",

    // Business Information - Hindi

    // IEC Information - Hindi

    // DSC Registration specific - Hindi
    individual_dsc_description:
      "यह DSC आपके व्यक्तिगत नाम पर जारी किया जाएगा और व्यक्तिगत डिजिटल हस्ताक्षर के लिए उपयोग किया जा सकता है।",
    authorization_letter_description: "संगठन की ओर से DSC आवेदन के लिए प्राधिकरण पत्र या बोर्ड संकल्प",
    dsc_application_submitted_processing:
      "आपका DSC पंजीकरण आवेदन जमा कर दिया गया है और वर्तमान में इसकी प्रक्रिया की जा रही है। आप प्रगति अनुभाग में प्रगति को ट्रैक कर सकते हैं।",
    // DSC Registration specific - Hindi
    individual_dsc_description:
      "यह DSC आपके व्यक्तिगत नाम पर जारी किया जाएगा और व्यक्तिगत डिजिटल हस्ताक्षर के लिए उपयोग किया जा सकता है।",
    // ICEGATE Registration specific - Hindi
    complete_required_sections_icegate: "अपने ICEGATE पंजीकरण के साथ आगे बढ़ने के लिए नीचे दिए गए सभी आवश्यक अनुभागों को पूरा करें",
    cancelled_cheque_description: "खाता सत्यापन के लिए रद्द चेक, बैंक स्टेटमेंट, या अपनी पासबुक का पहला पृष्ठ अपलोड करें।",
    icegate_definition_2: "• विभिन्न सीमा शुल्क दस्तावेजों के लिए ई-फाइलिंग सेवाएं प्रदान करता है (जैसे, बिल ऑफ एंट्री, शिपिंग बिल)",
    icegate_application_submitted_processing:
